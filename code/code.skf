// ============================================
//   skf-gui — аналог tkinter для SkyForge
//   от SkyMonder
// ============================================


// --------------------------------------------
//   ГЛАВНОЕ ОКНО
// --------------------------------------------

функция создать_окно(заголовок, ширина, высота) {
    // Создаёт главное окно приложения.
    // Возвращает объект-окно, с которым работают все остальные функции.
    подключить_питон("tkinter")
    
    если (заголовок == ничего) {
        заголовок = "SkyForge GUI"
    }
    если (ширина == ничего) {
        ширина = 600
    }
    если (высота == ничего) {
        высота = 400
    }
    
    пусть корень = tkinter.Tk()
    корень.title(заголовок)
    корень.geometry(строка(ширина) + "x" + строка(высота))
    
    пусть окно = {
        "корень": корень,
        "виджеты": [],
        "заголовок": заголовок
    }
    
    вернуть окно
}

функция запустить(окно) {
    // Запускает главный цикл приложения (блокирует выполнение).
    окно["корень"].mainloop()
}

функция закрыть(окно) {
    // Закрывает окно и завершает приложение.
    окно["корень"].destroy()
}

функция установить_заголовок(окно, заголовок) {
    // Меняет заголовок окна.
    окно["корень"].title(заголовок)
    окно["заголовок"] = заголовок
}

функция установить_размер(окно, ширина, высота) {
    // Меняет размер окна.
    окно["корень"].geometry(строка(ширина) + "x" + строка(высота))
}
