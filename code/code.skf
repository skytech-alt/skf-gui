// --------------------------------------------
//   МЕНЮ
// --------------------------------------------

функция меню(окно) {
    подключить_питон("tkinter")
    пусть м = tkinter.Menu(окно["корень"])
    окно["корень"].config(menu=м)
    вернуть {"объект": м}
}

функция пункт_меню(меню_объект, название, функция) {
    меню_объект["объект"].add_command(label=название, command=функция)
}

функция подменю(меню_объект, название) {
    подключить_питон("tkinter")
    пусть под = tkinter.Menu(меню_объект["объект"], tearoff=0)
    меню_объект["объект"].add_cascade(label=название, menu=под)
    вернуть {"объект": под}
}

функция разделитель_меню(меню_объект) {
    меню_объект["объект"].add_separator()
}


// --------------------------------------------
//   УТИЛИТЫ
// --------------------------------------------

функция задержка(окно, миллисекунды, функция) {
    // Выполняет функцию через указанное время (мс)
    окно["корень"].after(миллисекунды, функция)
}

функция повторять(окно, миллисекунды, функция) {
    // Повторяет функцию каждые N миллисекунд
    окно["корень"].after(миллисекунды, функция)
}
