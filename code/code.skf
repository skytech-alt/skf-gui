// ============================================
//   skf-gui — GUI-фреймворк для SkyForge
//   от SkyMonder
//   Расширенная версия: +7 виджетов
// ============================================


// --------------------------------------------
//   ГЛАВНОЕ ОКНО
// --------------------------------------------

функция создать_окно(заголовок, ширина, высота) {
    подключить_питон("tkinter")
    подключить_питон("tkinter.ttk")
    
    если (заголовок == ничего) {
        заголовок = "SkyForge GUI"
    }
    если (ширина == ничего) {
        ширина = 600
    }
    если (высота == ничего) {
        высота = 400
    }
    
    пусть корень = tkinter.Tk()
    корень.title(заголовок)
    корень.geometry(строка(ширина) + "x" + строка(высота))
    
    вернуть {
        "корень": корень,
        "виджеты": [],
        "заголовок": заголовок
    }
}

функция запустить(окно) {
    окно["корень"].mainloop()
}

функция закрыть(окно) {
    окно["корень"].destroy()
}

функция установить_заголовок(окно, заголовок) {
    окно["корень"].title(заголовок)
    окно["заголовок"] = заголовок
}

функция установить_размер(окно, ширина, высота) {
    окно["корень"].geometry(строка(ширина) + "x" + строка(высота))
}

функция центр_экрана(окно) {
    // Размещает окно по центру экрана
    окно["корень"].update_idletasks()
    пусть ш = окно["корень"].winfo_screenwidth()
    пусть в = окно["корень"].winfo_screenheight()
    пусть x = int((ш - окно["корень"].winfo_width()) / 2)
    пусть y = int((в - окно["корень"].winfo_height()) / 2)
    окно["корень"].geometry("+" + строка(x) + "+" + строка(y))
}

функция иконка(окно, путь) {
    // Устанавливает иконку окна (нужен .ico файл)
    попробовать {
        окно["корень"].iconbitmap(путь)
    } поймать (ошибка) {
        // Игнорируем
    }
}

функция не_изменять_размер(окно) {
    окно["корень"].resizable(0, 0)
}


// --------------------------------------------
//   БАЗОВЫЕ ПОМОЩНИКИ
// --------------------------------------------

функция _добавить(окно, виджет, имя) {
    окно["виджеты"].добавить({"имя": имя, "виджет": виджет})
    вернуть виджет
}

функция _найти(окно, имя) {
    для (запись в окно["виджеты"]) {
        если (запись["имя"] == имя) {
            вернуть запись["виджет"]
        }
    }
    бросить "Виджет не найден: " + имя
}

функция _поставить(виджет, x, y) {
    виджет.place(x=x, y=y)
}


// --------------------------------------------
//   ТЕКСТ И ЗАГОЛОВКИ
// --------------------------------------------

функция текст(окно, имя, содержимое, x, y) {
    подключить_питон("tkinter")
    если (x == ничего) { x = 10 }
    если (y == ничего) { y = 10 }
    
    пусть метка = tkinter.Label(окно["корень"], text=содержимое, font=("Arial", 12))
    _поставить(метка, x, y)
    вернуть _добавить(окно, метка, имя)
}

функция заголовок(окно, имя, содержимое, x, y) {
    подключить_питон("tkinter")
    если (x == ничего) { x = 10 }
    если (y == ничего) { y = 10 }
    
    пусть метка = tkinter.Label(окно["корень"], text=содержимое, font=("Arial", 18, "bold"))
    _поставить(метка, x, y)
    вернуть _добавить(окно, метка, имя)
}

функция обновить_текст(окно, имя, новый_текст) {
    пусть виджет = _найти(окно, имя)
    виджет.config(text=новый_текст)
}


// --------------------------------------------
//   КНОПКИ
// --------------------------------------------

функция кнопка(окно, имя, надпись, функция_нажатия, x, y) {
    подключить_питон("tkinter")
    если (x == ничего) { x = 10 }
    если (y == ничего) { y = 10 }
    
    пусть к = tkinter.Button(
        окно["корень"],
        text=надпись,
        command=функция_нажатия,
        font=("Arial", 12),
        padx=10,
        pady=5
    )
    _поставить(к, x, y)
    вернуть _добавить(окно, к, имя)
}

функция кнопка_со_стилем(окно, имя, надпись, функция_нажатия, x, y, цвет_фона, цвет_текста) {
    подключить_питон("tkinter")
    если (x == ничего) { x = 10 }
    если (y == ничего) { y = 10 }
    
    пусть к = tkinter.Button(
        окно["корень"],
        text=надпись,
        command=функция_нажатия,
        font=("Arial", 12),
        padx=10,
        pady=5
    )
    если (цвет_фона != ничего) { к.config(bg=цвет_фона) }
    если (цвет_текста != ничего) { к.config(fg=цвет_текста) }
    _поставить(к, x, y)
    вернуть _добавить(окно, к, имя)
}

функция отключить_кнопку(окно, имя) {
    _найти(окно, имя).config(state="disabled")
}

функция включить_кнопку(окно, имя) {
    _найти(окно, имя).config(state="normal")
}


// --------------------------------------------
//   ПОЛЯ ВВОДА
// --------------------------------------------

функция поле(окно, имя, x, y, ширина) {
    подключить_питон("tkinter")
    если (x == ничего) { x = 10 }
    если (y == ничего) { y = 10 }
    если (ширина == ничего) { ширина = 30 }
    
    пусть п = tkinter.Entry(окно["корень"], width=ширина, font=("Arial", 12))
    _поставить(п, x, y)
    вернуть _добавить(окно, п, имя)
}

функция поле_пароля(окно, имя, x, y, ширина) {
    подключить_питон("tkinter")
    если (x == ничего) { x = 10 }
    если (y == ничего) { y = 10 }
    если (ширина == ничего) { ширина = 30 }
    
    пусть п = tkinter.Entry(окно["корень"], width=ширина, font=("Arial", 12), show="*")
    _поставить(п, x, y)
    вернуть _добавить(окно, п, имя)
}

функция многострочное_поле(окно, имя, x, y, ширина, высота) {
    подключить_питон("tkinter")
    if (x == ничего) { x = 10 }
    if (y == ничего) { y = 10 }
    if (ширина == ничего) { ширина = 40 }
    if (высота == ничего) { высота = 10 }
    
    пусть п = tkinter.Text(окно["корень"], width=ширина, height=высота, font=("Arial", 12))
    _поставить(п, x, y)
    вернуть _добавить(окно, п, имя)
}

функция значение(окно, имя) {
    пусть виджет = _найти(окно, имя)
    вернуть виджет.get()
}

функция установить_значение(окно, имя, текст) {
    подключить_питон("tkinter")
    пусть виджет = _найти(окно, имя)
    попробовать {
        виджет.delete(0, tkinter.END)
        виджет.insert(0, текст)
    } поймать (ошибка) {
        // Для Text-виджета
        виджет.delete("1.0", tkinter.END)
        виджет.insert("1.0", текст)
    }
}

функция очистить_поле(окно, имя) {
    установить_значение(окно, имя, "")
}


// --------------------------------------------
//   ФЛАЖКИ (CHECKBOX)
// --------------------------------------------

функция флажок(окно, имя, надпись, x, y) {
    подключить_питон("tkinter")
    if (x == ничего) { x = 10 }
    if (y == ничего) { y = 10 }
    
    пусть переменная = tkinter.IntVar()
    пусть ф = tkinter.Checkbutton(
        окно["корень"],
        text=надпись,
        variable=переменная,
        font=("Arial", 12)
    )
    ф.var = переменная
    _поставить(ф, x, y)
    вернуть _добавить(окно, ф, имя)
}

функция флажок_включён?(окно, имя) {
    пусть виджет = _найти(окно, имя)
    вернуть виджет.var.get() == 1
}

функция установить_флажок(окно, имя, состояние) {
    пусть виджет = _найти(окно, имя)
    если (состояние) {
        виджет.var.set(1)
    } иначе {
        виджет.var.set(0)
    }
}


// --------------------------------------------
//   РАДИОКНОПКИ
// --------------------------------------------

функция радиогруппа(окно, имя, варианты, x, y) {
    // варианты — список строк: ["Мужской", "Женский"]
    подключить_питон("tkinter")
    if (x == ничего) { x = 10 }
    if (y == ничего) { y = 10 }
    
    пусть переменная = tkinter.StringVar()
    переменная.set(варианты[0])
    
    пусть кнопки = []
    пусть текущий_y = y
    для (вариант в варианты) {
        пусть р = tkinter.Radiobutton(
            окно["корень"],
            text=вариант,
            variable=переменная,
            value=вариант,
            font=("Arial", 12)
        )
        р.var = переменная
        _поставить(р, x, текущий_y)
        кнопки.добавить(р)
        текущий_y = текущий_y + 30
    }
    
    пусть группа = {
        "переменная": переменная,
        "кнопки": кнопки
    }
    
    окно["виджеты"].добавить({"имя": имя, "виджет": группа})
    вернуть группа
}

функция выбранный_вариант(окно, имя) {
    пусть группа = _найти(окно, имя)
    вернуть группа["переменная"].get()
}

функция установить_вариант(окно, имя, значение) {
    пусть группа = _найти(окно, имя)
    группа["переменная"].set(значение)
}


// --------------------------------------------
//   ВЫПАДАЮЩИЙ СПИСОК (COMBOBOX)
// --------------------------------------------

функция выпадающий_список(окно, имя, варианты, x, y, ширина) {
    подключить_питон("tkinter")
    подключить_питон("tkinter.ttk")
    if (x == ничего) { x = 10 }
    if (y == ничего) { y = 10 }
    if (ширина == ничего) { ширина = 25 }
    
    пусть комбо = tkinter.ttk.Combobox(
        окно["корень"],
        values=варианты,
        width=ширина,
        state="readonly",
        font=("Arial", 12)
    )
    если (длина(варианты) > 0) {
        комбо.current(0)
    }
    _поставить(комбо, x, y)
    вернуть _добавить(окно, комбо, имя)
}

функция значение_списка(окно, имя) {
    пусть виджет = _найти(окно, имя)
    вернуть виджет.get()
}

функция индекс_списка(окно, имя) {
    пусть виджет = _найти(окно, имя)
    вернуть виджет.current()
}

функция установить_список(окно, имя, значение) {
    пусть виджет = _найти(окно, имя)
    виджет.set(значение)
}

функция при_выборе(окно, имя, функция_обработчик) {
    // Привязывает обработчик к выбору в выпадающем списке
    пусть виджет = _найти(окно, имя)
    виджет.bind("<<ComboboxSelected>>", функция(событие) {
        функция_обработчик()
    })
}


// --------------------------------------------
//   ПОЛЗУНОК (SCALE)
// --------------------------------------------

функция ползунок(окно, имя, от, до, x, y, ориентация) {
    // ориентация: "горизонтально" или "вертикально"
    подключить_питон("tkinter")
    if (x == ничего) { x = 10 }
    if (y == ничего) { y = 10 }
    if (ориентация == ничего) { ориентация = "горизонтально" }
    
    пусть ориентация_код = "horizontal"
    если (ориентация == "вертикально") {
        ориентация_код = "vertical"
    }
    
    пусть п = tkinter.Scale(
        окно["корень"],
        from_=от,
        to=до,
        orient=ориентация_код,
        font=("Arial", 12)
    )
    _поставить(п, x, y)
    вернуть _добавить(окно, п, имя)
}

функция значение_ползунка(окно, имя) {
    пусть виджет = _найти(окно, имя)
    вернуть виджет.get()
}

функция установить_ползунок(окно, имя, значение) {
    пусть виджет = _найти(окно, имя)
    виджет.set(значение)
}


// --------------------------------------------
//   ПРОГРЕСС-БАР
// --------------------------------------------

функция прогресс_бар(окно, имя, x, y, ширина) {
    подключить_питон("tkinter")
    подключить_питон("tkinter.ttk")
    if (x == ничего) { x = 10 }
    if (y == ничего) { y = 10 }
    if (ширина == ничего) { ширина = 300 }
    
    пусть п = tkinter.ttk.Progressbar(
        окно["корень"],
        length=ширина,
        mode="determinate"
    )
    _поставить(п, x, y)
    вернуть _добавить(окно, п, имя)
}

функция установить_прогресс(окно, имя, процент) {
    пусть виджет = _найти(окно, имя)
    виджет["value"] = процент
}

функция прогресс_в_бесконечность(окно, имя) {
    пусть виджет = _найти(окно, имя)
    виджет.config(mode="indeterminate")
    виджет.start(10)
}

функция остановить_прогресс(окно, имя) {
    пусть виджет = _найти(окно, имя)
    виджет.stop()


// --------------------------------------------
//   ХОЛСТ (CANVAS) — РИСОВАНИЕ
// --------------------------------------------

функция холст(окно, имя, ширина, высота, x, y) {
    подключить_питон("tkinter")
    if (x == ничего) { x = 10 }
    if (y == ничего) { y = 10 }
    if (ширина == ничего) { ширина = 400 }
    if (высота == ничего) { высота = 300 }
    
    пусть х = tkinter.Canvas(
        окно["корень"],
        width=ширина,
        height=высота,
        bg="white"
    )
    _поставить(х, x, y)
    вернуть _добавить(окно, х, имя)
}

функция линия(окно, имя_холста, x1, y1, x2, y2, цвет, толщина) {
    пусть х = _найти(окно, имя_холста)
    если (цвет == ничего) { цвет = "black" }
    если (толщина == ничего) { толщина = 2 }
    вернуть х.create_line(x1, y1, x2, y2, fill=цвет, width=толщина)
}

функция прямоугольник(окно, имя_холста, x1, y1, x2, y2, цвет_заливки, цвет_рамки) {
    пусть х = _найти(окно, имя_холста)
    если (цвет_заливки == ничего) { цвет_заливки = "blue" }
    если (цвет_рамки == ничего) { цвет_рамки = "black" }
    вернуть х.create_rectangle(x1, y1, x2, y2, fill=цвет_заливки, outline=цвет_рамки)
}

функция овал(окно, имя_холста, x1, y1, x2, y2, цвет_заливки) {
    пусть х = _найти(окно, имя_холста)
    если (цвет_заливки == ничего) { цвет_заливки = "red" }
    вернуть х.create_oval(x1, y1, x2, y2, fill=цвет_заливки)
}

функция текст_на_холсте(окно, имя_холста, x, y, содержимое, цвет, размер) {
    пусть х = _найти(окно, имя_холста)
    если (цвет == ничего) { цвет = "black" }
    если (размер == ничего) { размер = 14 }
    вернуть х.create_text(x, y, text=содержимое, fill=цвет, font=("Arial", размер))
}

функция многоугольник(окно, имя_холста, точки, цвет_заливки) {
    // точки — список координат: [x1, y1, x2, y2, x3, y3, ...]
    пусть х = _найти(окно, имя_холста)
    если (цвет_заливки == ничего) { цвет_заливки = "green" }
    вернуть х.create_polygon(точки, fill=цвет_заливки)
}

функция очистить_холст(окно, имя_холста) {
    пусть х = _найти(окно, имя_холста)
    х.delete("all")
}

функция удалить_с_холста(окно, имя_холста, id_объекта) {
    пусть х = _найти(окно, имя_холста)
    х.delete(id_объекта)
}


// --------------------------------------------
//   ТАБЛИЦА (TREEVIEW)
// --------------------------------------------

функция таблица(окно, имя, колонки, x, y, ширина, высота) {
    // колонки — список названий: ["Имя", "Возраст", "Город"]
    подключить_питон("tkinter")
    подключить_питон("tkinter.ttk")
    if (x == ничего) { x = 10 }
    if (y == ничего) { y = 10 }
    if (ширина == ничего) { ширина = 500 }
    if (высота == ничего) { высота = 200 }
    
    пусть т = tkinter.ttk.Treeview(
        окно["корень"],
        columns=колонки,
        show="headings",
        height=высота
    )
    
    для (колонка в колонки) {
        т.heading(колонка, text=колонка)
        т.column(колонка, width=int(ширина / длина(колонки)))
    }
    
    _поставить(т, x, y)
    вернуть _добавить(окно, т, имя)
}

функция добавить_строку_таблицы(окно, имя, значения) {
    пусть т = _найти(окно, имя)
    т.insert("", "end", values=значения)
}

функция добавить_строки_таблицы(окно, имя, строки) {
    для (строка в строки) {
        добавить_строку_таблицы(окно, имя, строка)
    }
}

функция очистить_таблицу(окно, имя) {
    пусть т = _найти(окно, имя)
    для (элемент в т.get_children()) {
        т.delete(элемент)
    }
}

функция выделенная_строка(окно, имя) {
    пусть т = _найти(окно, имя)
    пусть выделение = т.selection()
    если (длина(выделение) == 0) {
        вернуть ничего
    }
    пусть элемент = т.item(выделение[0])
    вернуть элемент["values"]
}

функция при_выборе_строки(окно, имя, функция_обработчик) {
    пусть т = _найти(окно, имя)
    т.bind("<<TreeviewSelect>>", функция(событие) {
        функция_обработчик()
    })
}


// --------------------------------------------
//   ВКЛАДКИ (NOTEBOOK)
// --------------------------------------------

функция вкладки(окно, имя, x, y, ширина, высота) {
    подключить_питон("tkinter")
    подключить_питон("tkinter.ttk")
    if (x == ничего) { x = 0 }
    if (y == ничего) { y = 0 }
    if (ширина == ничего) { ширина = 580 }
    if (высота == ничего) { высота = 350 }
    
    пусть н = tkinter.ttk.Notebook(окно["корень"], width=ширина, height=высота)
    _поставить(н, x, y)
    
    пусть блокнот = {
        "виджет": н,
        "страницы": {}
    }
    
    окно["виджеты"].добавить({"имя": имя, "виджет": блокнот})
    вернуть блокнот
}

функция создать_вкладку(окно, имя_вкладок, название) {
    // Создаёт новую вкладку с указанным названием.
    // Возвращает фрейм, на который можно добавлять виджеты.
    подключить_питон("tkinter")
    
    пусть блокнот = _найти(окно, имя_вкладок)
    пусть фрейм = tkinter.Frame(блокнот["виджет"])
    
    блокнот["виджет"].add(фрейм, text=название)
    блокнот["страницы"][название] = фрейм
    
    вернуть фрейм
}

функция текст_на_вкладке(фрейм, имя, содержимое, x, y) {
    подключить_питон("tkinter")
    if (x == ничего) { x = 10 }
    if (y == ничего) { y = 10 }
    
    пусть метка = tkinter.Label(фрейм, text=содержимое, font=("Arial", 12))
    метка.place(x=x, y=y)
    вернуть метка
}

функция кнопка_на_вкладке(фрейм, имя, надпись, функция_нажатия, x, y) {
    подключить_питон("tkinter")
    if (x == ничего) { x = 10 }
    if (y == ничего) { y = 10 }
    
    пусть к = tkinter.Button(фрейм, text=надпись, command=функция_нажатия, font=("Arial", 12))
    к.place(x=x, y=y)
    вернуть к
}

функция поле_на_вкладке(фрейм, имя, x, y, ширина) {
    подключить_питон("tkinter")
    if (x == ничего) { x = 10 }
    if (y == ничего) { y = 10 }
    if (ширина == ничего) { ширина = 25 }
    
    пусть п = tkinter.Entry(фрейм, width=ширина, font=("Arial", 12))
    п.place(x=x, y=y)
    вернуть п
}


